# ==============================================================================
# MaxTrack - Root .gitignore
# Smart India Hackathon 2026 | Ministry of Railways / CRIS (PS 26027)
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Python Distribution & Packaging ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- SQLite & Local Databases ---
*.db
*.sqlite
*.sqlite3
backend/maxtrack.db

# --- Node.js & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Files & Secrets ---
.env
.env.*
*.env
!*.env.example

# --- IDEs & Code Editors ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*.sublime-project
*.sublime-workspace

# --- OS-Generated Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Temporary Files & Backups ---
*.tmp
*.bak
*.swp
*~

# --- Explicit Whitelists for Essential Machine Learning Assets ---
!Main - File/core/models/*.joblib
!Main - File/core/models/*.json
